{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:route", "destination": "/api?route=:route" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "0 15 * * *" }
  ]
}
