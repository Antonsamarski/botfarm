# Токен бота от @BotFather
BOT_TOKEN=
# Юзернейм бота без @
BOT_USERNAME=
# Короткое имя Mini App из BotFather (/newapp), если создано. Тогда ссылки сразу открывают приложение
BOT_APP_NAME=
# Telegram ID суперадминов через запятую (узнать: @userinfobot)
SUPERADMIN_IDS=
# Supabase → Connect → Transaction pooler (порт 6543)
DATABASE_URL=
# Любые длинные случайные строки
WEBHOOK_SECRET=
CRON_SECRET=
# Необязательно: адрес сайта, по умолчанию берётся домен Vercel
PUBLIC_URL=
